; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DVD BATTLE · V2 프리뷰 드래프트 핫픽스"
config/description="전략 자동 전투 시뮬레이터 — 불완전 정보 기반 전술 AI"
config/version="V2 프리뷰 · 드래프트 핫픽스"
config/use_custom_user_dir=true
config/custom_user_dir_name="DVD_BATTLE_V2_PREVIEW_DRAFT_HF1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0392157, 0.0509804, 0.0705882, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[input]

toggle_pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.0392157, 0.0509804, 0.0705882, 1)
